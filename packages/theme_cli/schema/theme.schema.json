                  "quartEaseOut",
                  "quartEaseInOut",
                  "quintEaseIn",
                  "quintEaseOut",
                  "quintEaseInOut",
                  "expoEaseIn",
                  "expoEaseOut",
                  "expoEaseInOut",
                  "circEaseIn",
                  "circEaseOut",
                  "circEaseInOut",
                  "backEaseIn",
                  "backEaseOut",
                  "backEaseInOut",
                  "elasticEaseIn",
                  "elasticEaseOut",
                  "elasticEaseInOut",
                  "bounceEaseIn",
                  "bounceEaseOut",
                  "bounceEaseInOut"
