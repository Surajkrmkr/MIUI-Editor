        },
        "gradEndAlign": {
          "$ref": "#/$defs/alignment"
        },
        "align": {
          "$ref": "#/$defs/alignment"
        },
        "font": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "fontWeight": {
          "description": "\"FontWeight.w700\" or 700.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^FontWeight\\.w[1-9]00$"
            },
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 900
            }
          ]
        },
        "isShort": {
          "type": "boolean"
        },
        "isWrap": {
          "type": "boolean"
        },
        "showGuideLines": {
